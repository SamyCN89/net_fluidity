# ==========================================
# PYTHON ENVIRONMENT
# ==========================================

# Add your project to Python path for imports
PYTHONPATH=/home/samy/Bureau/vscode/net_fluidity


# ==========================================
# PROJECT ROOTS
# ==========================================

# Local workstation project root
PROJECT_ROOT_LOCAL=/media/samy/Elements2/Proyectos/LauraHarsan

# Cluster filesystem roots (different HPC mounts)
PROJECT_ROOT_CLUSTER_FUNSYMANIA=/mnt/sdc/samy
PROJECT_ROOT_CLUSTER_FUNSYSTRA=/mnt/data/samy
PROJECT_ROOT_CLUSTER_FUNSYSTEM=/mnt/sdb/samy

# Default PATHS_ROOT (will be overridden automatically in script)
PATHS_ROOT=${PROJECT_ROOT_LOCAL}


# ==========================================
# ENVIRONMENT SWITCH
# ==========================================

# Choose your runtime environment:
#   LOCAL        → for laptop/desktop
#   FUNSYMANIA   → cluster at /mnt/sdc/samy
#   FUNSYSTRA    → cluster at /mnt/data/samy
#   FUNSYSTEM    → cluster at /mnt/sdb/samy
#
# The Bash script auto-assigns PATHS_ROOT based on this flag.
PATHS_ENV=AUTO


# ==========================================
# DATASET CONFIGURATION
# ==========================================

# Dataset to process
DATASET_NAME=julien_caillette

# Derived dataset paths (for convenience)
LOCAL_DATA_DIR=${PROJECT_ROOT_LOCAL}/dataset/${DATASET_NAME}
CLUSTER_DATA_DIR_FUNSYMANIA=${PROJECT_ROOT_CLUSTER_FUNSYMANIA}/dataset/${DATASET_NAME}
CLUSTER_DATA_DIR_FUNSYSTRA=${PROJECT_ROOT_CLUSTER_FUNSYSTRA}/dataset/${DATASET_NAME}
CLUSTER_DATA_DIR_FUNSYSTEM=${PROJECT_ROOT_CLUSTER_FUNSYSTEM}/dataset/${DATASET_NAME}


# ==========================================
# REMOTE / SYNC SETTINGS (optional)
# ==========================================

# Optional synchronization paths for rsync/scp jobs
# LOCAL_DIR=/media/samy/Elements1/Proyectos/LauraHarsan/dataset/${DATASET_NAME}
# REMOTE_DIR=/home/samy/Proyectos/LauraHarsan/dataset/${DATASET_NAME}

