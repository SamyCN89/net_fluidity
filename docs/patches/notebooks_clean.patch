+
+            pooled.append(arr)
+
+        if pooled:
+
+            flat = np.concatenate(pooled)
+
+            per_animal_speed.append(np.median(flat))  # Or np.mean, or np.quantile(flat, ...)
+
+        else:
+
+            per_animal_speed.append(np.nan)
+
+    # Assemble DataFrame
+
+    df = pd.DataFrame({
