+def group_label_sort(g1, g2):
+
+    """Return WT group first if present, else alphabetical."""
+
+    if 'WT' in g1 and 'WT' not in g2:
+
+        return (g1, g2)
+
+    elif 'WT' not in g1 and 'WT' in g2:
+
+        return (g2, g1)
+
+    else:
+
+        # Fallback: alphabetically
+
+        return (g1, g2)
+
