import numpy as np
import matplotlib.pyplot as plt
from scipy.stats import gaussian_kde



def kde_fun(data):
    """Compute the kernel density estimate of the given data."""
    kde = gaussian_kde(data)
    xx = np.linspace(data.min(), data.max(), 500)
    return kde, xx





# Example data
kde_groups, xx = kde_fun(T[mask].flatten())

# Plot
